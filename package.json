{
  "name": "ayla-tools-web",
  "version": "0.42.0-ayla.3",
  "private": true,
  "description": "Maintained fork of pi-web-access for Pi 1.3.0: web search, URL fetching, GitHub repo cloning, PDF extraction, YouTube video understanding, and local video analysis. Standalone package with no personal Pi profile, and with an honest multi-provider matrix.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import ./test/isolate-env.mjs --test",
    "typecheck": "tsc",
    "audit:runtime": "npm audit --omit=dev --omit=peer",
    "build": "node scripts/build.js",
    "verify:install": "node scripts/verify-git-install.mjs"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "extension",
    "web-search",
    "fetch",
    "scraping",
    "tinyfish",
    "search1api",
    "searchinfinity",
    "querit",
    "degoog",
    "perplexity"
  ],
  "author": "Nico Bailon",
  "contributors": [
    "kekma-dot (maintained fork)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kekma-dot/ayla-tools-web.git"
  },
  "bugs": {
    "url": "https://github.com/kekma-dot/ayla-tools-web/issues"
  },
  "homepage": "https://github.com/kekma-dot/ayla-tools-web#readme",
  "files": [
    "dist",
    "*.ts",
    "README.md",
    "README.ru.md",
    "assets",
    "LICENSE",
    "provenance.json",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD-PARTY-NOTICES"
  ],
  "bin": {
    "pi-web-access-mcp": "dist/mcp-cli.js"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.1",
    "typebox": "1.3.27",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "defuddle": "0.19.3",
    "linkedom": "^0.16.0",
    "marked": "18.0.11",
    "p-limit": "^6.1.0",
    "promise.try": "^2.0.1",
    "turndown": "^7.2.0",
    "undici": "^8.11.2",
    "unpdf": "^1.6.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
